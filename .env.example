# Railway sets DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/wndrr_ad_pipeline

# Shared password for the app's login gate (internal tool, single shared password).
APP_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-too

# Set to "true" once, locally, if you want the example categories/styles in db/seed.sql loaded.
SEED_EXAMPLE_DATA=false

# ApparelMagic (Planning stage). Reuses the same integration pattern as
# aminventory/adcreationworkflow/demandplanning. Leave unset to run with
# Planning's ApparelMagic-dependent features gracefully disabled.
AM_SUBDOMAIN=
AM_TOKEN=
# Confirmed via demandplanning's AM data migration: warehouse 1002 is
# "Shopify Online Store" -- the natural default for "what's sellable".
AM_WAREHOUSE_IDS=1002

# Report Pipeline (High Stock Recommendations' Platinum/Rocket tier). Same
# internal service "demand planning v2" (brendanolver/demandplanning) reads
# for its own performance-tier classification. Leave unset to run with
# High Stock gracefully disabled (empty list, no error).
PIPELINE_BASE_URL=
PIPELINE_TOKEN=

# Meta Marketing API (live "X live on Meta" count on Drop coverage cards,
# shown alongside the existing creative_assets coverage number). Needs a
# Meta System User token with ads_read on the WNDRR ad account. Leave unset
# to run with this feature gracefully disabled (no live count shown).
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Automatic RECENT Meta performance sync (read-only, last 3 days every 3 h, last 7 days once a day, never a backfill).
# Set to off to disable. Default: on whenever the two Meta variables above are set.
# META_AUTO_SYNC=on

# Creative Planning seasonality: which sales history to read (see docs/seasonal-sales-source.md).
# Shopify online orders are preferred when these are set; otherwise ApparelMagic online sales are used (and the Planning page says which).
# The token must be a READ-ONLY Shopify custom-app token (read_orders; read_all_orders to see beyond 60 days). It stays on the server: it is never
# sent to the browser, and this app does NOT call the Demand Planning app's public sales endpoint.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_SALES_LOOKBACK_DAYS=730
# SEASONAL_SALES_SOURCE=auto   # auto | shopify (no fallback) | apparelmagic

# AI Copy Assistant (Ad Setup > Primary Text). Claude is the default provider; OpenAI is an optional second provider for a side-by-side comparison.
# OpenAI API usage is billed separately from any ChatGPT subscription. Leave a key unset to run without that provider (it is shown as "not set up").
# ANTHROPIC_API_KEY=
# COPY_AI_MODEL=
# OPENAI_API_KEY=
# OPENAI_COPY_MODEL=gpt-6-sol   (default; gpt-6.1-sol is OpenAI's newer Sol model at the same price)
# OPENAI_COPY_REASONING=low

PORT=3000
NODE_ENV=development
