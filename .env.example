# Railway sets DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/wndrr_ad_pipeline

# Shared password for the app's login gate (internal tool, single shared password).
APP_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-too

# Set to "true" once, locally, if you want the example categories/styles in db/seed.sql loaded.
SEED_EXAMPLE_DATA=false

# ApparelMagic (Planning stage). Reuses the same integration pattern as
# aminventory/adcreationworkflow/demandplanning. Leave unset to run with
# Planning's ApparelMagic-dependent features gracefully disabled.
AM_SUBDOMAIN=
AM_TOKEN=
# Confirmed via demandplanning's AM data migration: warehouse 1002 is
# "Shopify Online Store" -- the natural default for "what's sellable".
AM_WAREHOUSE_IDS=1002

# Report Pipeline (High Stock Recommendations' Platinum/Rocket tier). Same
# internal service "demand planning v2" (brendanolver/demandplanning) reads
# for its own performance-tier classification. Leave unset to run with
# High Stock gracefully disabled (empty list, no error).
PIPELINE_BASE_URL=
PIPELINE_TOKEN=

# Meta Marketing API (live "X live on Meta" count on Drop coverage cards,
# shown alongside the existing creative_assets coverage number). Needs a
# Meta System User token with ads_read on the WNDRR ad account. Leave unset
# to run with this feature gracefully disabled (no live count shown).
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=

PORT=3000
NODE_ENV=development
