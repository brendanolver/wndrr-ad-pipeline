# Railway sets DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/wndrr_ad_pipeline

# Shared password for the app's login gate (internal tool, single shared password).
APP_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-too

# Set to "true" once, locally, if you want the example categories/styles in db/seed.sql loaded.
SEED_EXAMPLE_DATA=false

PORT=3000
NODE_ENV=development
